# Salin file ini menjadi .env lalu isi sesuai mesin kamu.
# .env TIDAK BOLEH di-commit (sudah masuk .gitignore).

# --- Postgres (untuk n8n, chat memory, dan log) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=ganti-dengan-password-lokal-kamu
POSTGRES_DB=n8n

# --- Ollama (install native di host, bukan di Docker) ---
# Dari dalam container n8n, host dicapai lewat host.docker.internal.
OLLAMA_HOST=host.docker.internal:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# Model kecil khusus slot Model di tool search_knowledge_base (perumus query + sintesis chunk).
TOOL_LLM_MODEL=qwen2.5:3b-instruct
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chatbox_knowledge

# --- MCP Server database (isi setelah MCP diterima dari tim) ---
# Transport HTTP/SSE: isi URL-nya. Transport stdio: isi command-nya.
MCP_URL=
MCP_COMMAND=
MCP_AUTH_TOKEN=

# --- Data & umum ---
# Folder berisi SOP/FAQ lokal (relatif terhadap infra/, atau path absolut).
DATA_DIR=../data
GENERIC_TIMEZONE=Asia/Jakarta
